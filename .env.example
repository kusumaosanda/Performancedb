# Copy this file to .env and paste your own token:
#     cp .env.example .env
#     chmod 600 .env
#
# Token: github.com → Settings → Developer settings →
#        Personal access tokens (classic) → Generate new token
#        Required scope: repo
#
# .env is listed in .gitignore and is never uploaded by ./deploy.sh --source.

GITHUB_TOKEN=paste_your_token_here
GITHUB_REPO=kusumaosanda/Performancedb
GITHUB_BRANCH=main
